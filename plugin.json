  "platform": ["win32"],
  "pluginSetting": {
    "height": 720
  },
  "features": [
    {
      "code": "dsh-pet",
      "explain": "dsh 桌宠",
      "cmds": ["dsh桌宠", "dsh pet", "桌宠"]
